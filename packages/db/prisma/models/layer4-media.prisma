// Layer 4: Media

model MediaAsset {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  source      String
  originalUrl String   @map("original_url")
  storagePath String?  @map("storage_path")
  fileType    String   @map("file_type")
  width       Int?
  height      Int?
  status      String   @default("raw")
  uploadedAt  DateTime @default(now()) @map("uploaded_at")

  business        Business         @relation(fields: [businessId], references: [id])
  processedImages ProcessedImage[]
  facultyMemberPhotos FacultyMember[] @relation("FacultyMemberPhoto")
  doctorPhotos        Doctor[]        @relation("DoctorPhoto")
  menuItemPhotos      MenuItem[]      @relation("MenuItemPhoto")
  salonServicePhotos  SalonService[]  @relation("SalonServicePhoto")

  @@index([businessId])
  @@map("media_assets")
}

model ProcessedImage {
  id           String   @id @default(uuid()) @db.Uuid
  mediaAssetId String   @map("media_asset_id") @db.Uuid
  operation    String
  outputPath   String   @map("output_path")
  width        Int?
  height       Int?
  processedAt  DateTime @default(now()) @map("processed_at")

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id])

  @@index([mediaAssetId])
  @@map("processed_images")
}
