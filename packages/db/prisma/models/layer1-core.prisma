enum Language {
  ENGLISH
  SPANISH
  FRENCH
  GERMAN
  ITALIAN
  PORTUGUESE
  RUSSIAN
  CHINESE
}

// Layer 1: Core entities

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String
  phone     String?
  whatsapp  String?
  password  String
  createdAt DateTime @default(now()) @map("created_at")

  businesses Business[]

  @@map("users")
}

model BusinessCategory {
  id              String  @id @default(uuid()) @db.Uuid
  name            String
  slug            String  @unique
  parentId        String? @map("parent_id") @db.Uuid
  ctaType         String  @map("cta_type")
  sitemapTemplate Json    @map("sitemap_template")

  parent     BusinessCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children   BusinessCategory[] @relation("CategoryHierarchy")
  businesses Business[]

  @@index([parentId])
  @@map("business_categories")
}

model Business {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  categoryId        String           @map("category_id") @db.Uuid
  name              String
  city              String
  phone             String?
  whatsapp          String?
  address           BusinessAddress?
  language          Language         @default(ENGLISH)
  positioningTier   String           @map("positioning_tier")
  positioningDetail String?          @map("positioning_detail")
  status            String           @default("draft")
  createdAt         DateTime         @default(now()) @map("created_at")

  user     User             @relation(fields: [userId], references: [id])
  category BusinessCategory @relation(fields: [categoryId], references: [id])

  dataSources        BusinessDataSource[]
  competitors        Competitor[]
  mediaAssets        MediaAsset[]
  websitePages       WebsitePage[]
  websiteGenerations WebsiteGeneration[]
  strategies         BusinessStrategy[]
  signalProfile      BusinessSignalProfile?
  competitorInsight  CompetitorInsight?
  restaurantDetails  RestaurantDetails?
  clinicDetails      ClinicDetails?
  salonDetails       SalonDetails?
  coachingDetails    CoachingDetails?
  facultyMembers     FacultyMember[]
  doctors            Doctor[]
  menuItems          MenuItem[]
  salonServices      SalonService[]

  @@index([userId])
  @@index([categoryId])
  @@map("businesses")
}

model BusinessAddress {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @unique @map("business_id") @db.Uuid
  address    String
  city       String
  state      String
  country    String
  postalCode String
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("business_addresses")
}
